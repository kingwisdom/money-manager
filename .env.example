# ─── Application ────────────────────────────────────────────────────────────
# APP_NAME must be quoted if it contains spaces.
APP_NAME="Money Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Currency symbol shown across the app for new users (e.g. $, €, £, ₦)
APP_CURRENCY=$

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ─── Database (MySQL on shared hosting) ──────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# ─── Sessions, Cache & Queue ─────────────────────────────────────────────────
# All use the database driver so no Redis is required on shared hosting.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

QUEUE_CONNECTION=database

# ─── Filesystem ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Mail (use SMTP on production so password resets are delivered) ──────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite / Frontend ─────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ─── Optional / unused on shared hosting ─────────────────────────────────────
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
BROADCAST_CONNECTION=log
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
